# ---- Netlify environment variables (Site settings → Environment variables) ----
# The Odds API (https://the-odds-api.com) — free tier = 500 credits/month
ODDS_API_KEY=
# Verify the exact World Cup key by calling /v4/sports once; commonly:
ODDS_SPORT_KEY=soccer_fifa_world_cup

# Supabase (Project settings → API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=          # service_role secret — server-side only, never in the front end
POOL_ID=                       # printed by schema.sql when you run it

# shared secrets
CRON_SECRET=                   # any random string; also set as a GitHub Actions secret
ADMIN_SECRET=                  # any random string; you type this into the app's Admin panel

# ---- GitHub repo → Settings → Secrets and variables → Actions ----
# SITE_URL=https://YOUR-SITE.netlify.app
# CRON_SECRET=  (same value as above)
